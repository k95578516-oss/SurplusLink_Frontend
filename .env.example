# Frontend environment variables (Vite). Only PUBLIC values belong here: they are embedded in the bundle.

# Production / preview: full URL of the deployed backend API, including /api, no trailing slash.
# Leave empty for local development (the Vite dev server proxies /api to the backend).
VITE_API_BASE_URL=https://your-backend.example.com/api

# Local development only: where the dev proxy forwards /api (default http://localhost:8080)
VITE_DEV_PROXY_TARGET=http://localhost:8080
